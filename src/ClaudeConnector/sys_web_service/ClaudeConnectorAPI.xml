<?xml version="1.0" encoding="UTF-8"?>
<!--
  Scripted REST API definition
  Table : sys_ws_definition  (parent)  +  sys_ws_operation  (resources)
  Scope : x_ibm_claudeconn
-->
<record_update table="sys_ws_definition">
  <sys_ws_definition action="INSERT_OR_UPDATE">
    <active>true</active>
    <base_api_path>/api/x_ibm_claudeconn/claude</base_api_path>
    <consumes>application/json</consumes>
    <consumes_customized>false</consumes_customized>
    <description>Scripted REST API for Claude Connector. Provides /chat and /clear endpoints consumed by the UI Page and Service Portal widget.</description>
    <enforces_acl>true</enforces_acl>
    <name>ClaudeConnectorAPI</name>
    <produces>application/json</produces>
    <produces_customized>false</produces_customized>
    <sys_scope>x_ibm_claudeconn</sys_scope>
  </sys_ws_definition>
</record_update>

<record_update table="sys_ws_operation">
  <!-- POST /chat -->
  <sys_ws_operation action="INSERT_OR_UPDATE">
    <active>true</active>
    <consumes_customized>false</consumes_customized>
    <http_method>POST</http_method>
    <name>chat</name>
    <operation_uri>/chat</operation_uri>
    <produces_customized>false</produces_customized>
    <relative_path>/chat</relative_path>
    <request_example><![CDATA[
{
  "prompt":         "Explain REST APIs in one paragraph.",
  "model":          "claude-sonnet-5",
  "system_prompt":  "You are a helpful assistant.",
  "prefill":        "",
  "stop_sequences": ""
}
    ]]></request_example>
    <script><![CDATA[
      // loaded from ClaudeConnectorAPI_chat.script.js
    ]]></script>
    <sys_scope>x_ibm_claudeconn</sys_scope>
    <web_service_definition>ClaudeConnectorAPI</web_service_definition>
  </sys_ws_operation>

  <!-- POST /clear -->
  <sys_ws_operation action="INSERT_OR_UPDATE">
    <active>true</active>
    <consumes_customized>false</consumes_customized>
    <http_method>POST</http_method>
    <name>clear</name>
    <operation_uri>/clear</operation_uri>
    <produces_customized>false</produces_customized>
    <relative_path>/clear</relative_path>
    <script><![CDATA[
      // loaded from ClaudeConnectorAPI_clear.script.js
    ]]></script>
    <sys_scope>x_ibm_claudeconn</sys_scope>
    <web_service_definition>ClaudeConnectorAPI</web_service_definition>
  </sys_ws_operation>

  <!-- GET /models -->
  <sys_ws_operation action="INSERT_OR_UPDATE">
    <active>true</active>
    <consumes_customized>false</consumes_customized>
    <http_method>GET</http_method>
    <name>models</name>
    <operation_uri>/models</operation_uri>
    <produces_customized>false</produces_customized>
    <relative_path>/models</relative_path>
    <script><![CDATA[
(function process(request, response) {
    response.setStatus(200);
    response.setBody({
        models: ['claude-sonnet-5', 'claude-opus-4-8', 'claude-haiku-4-5'],
        default_model: gs.getProperty('x_ibm_claudeconn.default_model', 'claude-sonnet-5')
    });
})(request, response);
    ]]></script>
    <sys_scope>x_ibm_claudeconn</sys_scope>
    <web_service_definition>ClaudeConnectorAPI</web_service_definition>
  </sys_ws_operation>
</record_update>
